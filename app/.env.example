# SafarGo demo environment. Copy to .env for local development.
# NEVER commit real secrets. All values below are sandbox/demo defaults.

PORT=3001
DB_FILE=./safargo.db
JWT_SECRET=change-me-in-production                 # used to sign auth session tokens
COOKIE_SECURE=0                                   # set 1 behind HTTPS
DEMO_SEED_DEPARTURES_DAYS=60                      # how many days of schedules to seed

# ---- Payment provider adapter ----------------------------------------------
# PAY_PROVIDER=demo     -> clearly-labelled local sandbox (no real money moves)
# PAY_PROVIDER=razorpay -> requires the razorpay npm package + real keys
PAY_PROVIDER=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Notification adapters --------------------------------------------------
# email: 'console' prints to server logs; configure SMTP for production.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMS_PROVIDER=console          # e.g. MSG91 / Twilio in production
MSG91_AUTH_KEY=
WHATAPP_PROVIDER=console

# ---- Maps --------------------------------------------------------------------
MAPS_PROVIDER=none            # set to 'google' with a key to enable live tracking map
GOOGLE_MAPS_API_KEY=
